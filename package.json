    "@octokit/webhooks-examples": "^7.6.1",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "lz-string": "^1.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
